# ==========================================================
# YEMOLAM SHOES — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub.
# ==========================================================

# --- Supabase ---
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — SERVER-SIDE ONLY. Never expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---
# Found in: Paystack Dashboard > Settings > API Keys & Webhooks
# Public key is safe in frontend JS (js/checkout.js). Secret key is
# used only inside /api serverless functions.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Email notifications ---
# Any transactional email provider works (Resend, Postmark, SendGrid...)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=orders@yemolamshoes.com

# --- WhatsApp ---
# Digits only, country code first, no + or spaces (e.g. 2348012345678)
WHATSAPP_NUMBER=2348169321538

# --- Site ---
# Used for Paystack's callback_url in /api/create-order.js
PUBLIC_SITE_URL=https://yourdomain.com
